# Supabase project (Project Settings -> API in the Supabase dashboard).
# Put the real values in a file named .env.local next to package.json (this file is only a template).
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"

# Optional TURN server for the Voice Sanctuary (needed for people on some mobile
# networks). Comma-separated turn:/turns: URLs, from a provider such as
# Metered, Twilio, Xirsys or Cloudflare, or your own coturn.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# The AI (Gemini), Seek (Groq) and live Bible features are switched off for now, so no keys are needed.
# If you turn them on later, set GEMINI_API_KEY, GROQ_KEY_1..3 and BIBLE_API_KEY on the SERVER only.

# Push notifications (Phase 2). The PUBLIC half of the push key pair. Generate the pair with:
#   npx web-push generate-vapid-keys
# The public key goes here (safe to expose); the PRIVATE key goes only into the Supabase secrets.
VITE_VAPID_PUBLIC_KEY=
